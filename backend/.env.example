# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=emergency_dispatch

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=24h
DISPATCH_RADIUS_KM=25
DISPATCH_ACCEPT_TIMEOUT_SECONDS=60
AVG_SPEED_KMH=32